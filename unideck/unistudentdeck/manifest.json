{
  "manifest_version": 3,
  "key": "",
  "name": "UniStudentDeck",
  "version": "0.8.0",
  "version_name": "0.8.0 beta",
  "description": "UniDeck for students: a calm study dashboard for undergraduate and graduate students. Assignments, reading list, notes, focus timer, Files viewer for PDFs and Google docs, Translate, Dictionary, Flashcards, study stats and a private journal.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*"
  ],
  "sandbox": {
    "pages": [
      "games/*"
    ]
  }
}
