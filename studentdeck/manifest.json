{
  "manifest_version": 3,
  "name": "StudentDeck",
  "version": "0.27.0",
  "version_name": "0.27.0",
  "description": "A study dashboard for students: focus timer, homework, reading log, games, flashcards, a journal, a scrapbook, files and XP.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "optional_permissions": ["identity"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*"
  ],
  "sandbox": {
    "pages": [
      "games/*"
    ]
  }
}
